rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // username -> uid lookup (needed to add friends)
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid;

      // PRIVATE DIARY: only the owner
      match /diary/{id} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // Friend requests + chats
    match /friendships/{fid} {
      allow read: if request.auth.uid in resource.data.users;
      allow create: if request.auth.uid in request.resource.data.users
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth.uid in resource.data.users
                    && resource.data.from != request.auth.uid
                    && request.resource.data.users == resource.data.users;
      allow delete: if request.auth.uid in resource.data.users;

      // Messages: only between accepted friends
      match /messages/{mid} {
        function ok() {
          let f = get(/databases/$(db)/documents/friendships/$(fid)).data;
          return f.status == 'accepted' && request.auth.uid in f.users;
        }
        allow read: if ok();
        allow create: if ok() && request.resource.data.from == request.auth.uid;
      }
    }
  }
}
